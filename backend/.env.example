# Copy to backend/.env and adjust. Never commit the real .env.

# PostgreSQL — used by the backend and by the `db` service in docker-compose.
POSTGRES_USER=lumatic
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lumatic
# Manual setup: localhost. docker-compose overrides this with the `db` service host.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]
# Purge expired trash items at startup and every 24h (retention is set in the app's Settings).
TRASH_AUTO_PURGE=true

# Set to 1 to run repository tests against the database above (inside a rolled-back transaction).
RUN_INTEGRATION_TESTS=0
